<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/video_player_controls_gradient"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            app:bar_gravity="bottom"
            app:bar_height="3dp"
            app:scrubber_dragged_size="20dp"
            app:scrubber_enabled_size="16dp"
            app:touch_target_height="48dp" />

        <FrameLayout
            android:id="@+id/video_controls_buttons"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:gravity="center_vertical|start"
                android:paddingStart="4dp"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/video_previous"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/exo_controls_previous_description"
                    android:padding="15dp"
                    android:src="@drawable/ic_video_previous"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@id/exo_play_pause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/exo_controls_play_description"
                    android:padding="14dp"
                    android:src="@drawable/exo_icon_play"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/video_next"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/exo_controls_next_description"
                    android:padding="15dp"
                    android:src="@drawable/ic_video_next"
                    android:tint="@android:color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical|end"
                android:paddingEnd="4dp"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
