<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/video_player_controls_gradient"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minWidth="64dp"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:bar_gravity="center"
                app:bar_height="3dp"
                app:scrubber_dragged_size="20dp"
                app:scrubber_enabled_size="16dp"
                app:touch_target_height="48dp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minWidth="64dp"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/video_controls_buttons"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/video_track_buttons"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@id/exo_audio_track"
                    style="@style/ExoStyledControls.Button.Bottom.AudioTrack" />

                <ImageButton
                    android:id="@id/exo_subtitle"
                    style="@style/ExoStyledControls.Button.Bottom.CC" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/video_transport"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/video_previous"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/exo_controls_previous_description"
                        android:padding="12dp"
                        android:src="@drawable/ic_video_previous"
                        android:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/video_rewind"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/exo_controls_rewind_description"
                        android:padding="12dp"
                        android:src="@drawable/ic_video_rewind"
                        android:tint="@android:color/white" />

                    <ImageButton
                        android:id="@id/exo_play_pause"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/exo_controls_play_description"
                        android:padding="14dp"
                        android:src="@drawable/exo_icon_play"
                        android:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/video_forward"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/exo_controls_fastforward_description"
                        android:padding="12dp"
                        android:src="@drawable/ic_video_fastforward"
                        android:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/video_next"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/exo_controls_next_description"
                        android:padding="12dp"
                        android:src="@drawable/ic_video_next"
                        android:tint="@android:color/white" />

                </LinearLayout>

            </LinearLayout>

            <!-- Matches the track buttons when the row is wide enough, so transport stays centered. -->
            <View
                android:id="@+id/video_track_balance"
                android:layout_width="0dp"
                android:layout_height="0dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
