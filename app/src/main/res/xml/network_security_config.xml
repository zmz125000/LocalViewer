<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (http://) is permitted so LAN WebDAV/NAS can use explicit http URLs.
  This does NOT weaken HTTPS: https:// still uses system trust anchors only.
  Self-signed / bad certs need Settings → Advanced → "Allow insecure TLS" (code path).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
